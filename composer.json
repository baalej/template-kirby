{
  "name": "baalej/template-kirby",
  "description": "Plantilla base para proyectos Kirby",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3.0",
    "getkirby/cms": "~5.6.1"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 kirby/router.php"
    ]
  }
}
